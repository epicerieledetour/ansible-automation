#!/usr/bin/python3
# {{ ansible_managed }}
#
# Counts the members of the Slack workspace by type and writes the counts to
# slack.prom in $STATE_DIRECTORY, for slack-metrics.service to move to
# node_exporter's textfile collector directory. The service also passes the
# bot token as the slack-token credential.
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

SLACK_USERS_URL = "https://slack.com/api/users.list"
# All member types
TYPES = ["full", "multi_channel_guest", "single_channel_guest", "bot", "deleted"]


def request(req, attempts=3):
    """urlopen helper, retried on network errors, 5xx and 429 like curl --retry"""
    for attempt in range(1, attempts + 1):
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                return resp.read()
        except (urllib.error.URLError, OSError) as e:
            final = (isinstance(e, urllib.error.HTTPError)
                     and e.code < 500 and e.code != 429)
            if final or attempt == attempts:
                raise
            print(f"{req.full_url}: {e}, retrying", file=sys.stderr)
            time.sleep(2 * attempt)


# Slack


# Errors where Slack answers with HTTP 200 but asks to retry, seen in the wild
# as a fatal_error that lasted twenty minutes
SLACK_TRANSIENT_ERRORS = {"fatal_error", "internal_error", "service_unavailable"}


def users_page(token, cursor, attempts=3):
    """One page of users.list, retried on Slack's transient errors"""
    # Slack accepts up to 1000 members per page, but recommends no more than 200
    query = urllib.parse.urlencode({"limit": 200, "cursor": cursor})
    req = urllib.request.Request(f"{SLACK_USERS_URL}?{query}",
                                 headers={"Authorization": f"Bearer {token}"})
    for attempt in range(1, attempts + 1):
        resp = json.loads(request(req))
        if resp.get("ok"):
            return resp
        # Slack answers errors (invalid_auth, missing_scope...) with HTTP 200
        if resp.get("error") not in SLACK_TRANSIENT_ERRORS or attempt == attempts:
            sys.exit(f"users.list: {json.dumps(resp)}")
        print(f"users.list: {resp['error']}, retrying", file=sys.stderr)
        time.sleep(10 * attempt)


def members(token):
    """Every member of every page of users.list.
    Returns an iterator of every member fetched"""
    cursor = ""
    while True:
        resp = users_page(token, cursor)
        # Hands this page's members out one by one, then fetches the next page
        yield from resp["members"]
        cursor = resp.get("response_metadata", {}).get("next_cursor", "")
        if not cursor:
            return


def kind(member):
    if member.get("deleted"):
        return "deleted"
    # Slackbot has is_bot false, like a human member, and the same USLACKBOT id
    # in every workspace: count it as the bot it is
    if member.get("is_bot") or member["id"] == "USLACKBOT":
        return "bot"
    if member.get("is_ultra_restricted"):
        return "single_channel_guest"
    if member.get("is_restricted"):
        return "multi_channel_guest"
    return "full"


# node_exporter textfile


def render(counts):
    """The counts in prometheus' text exposition format"""
    lines = [
        "# HELP slack_workspace_members Members of the Slack workspace, by type.",
        "# TYPE slack_workspace_members gauge",
    ]
    for member_type, count in counts.items():
        # Not an f-string: its doubled braces would be read by Jinja
        lines.append('slack_workspace_members{type="%s"} %d' % (member_type, count))
    return "\n".join(lines) + "\n"


def write_textfile(content):
    """slack.prom in the service's state directory. Nothing reads it there:
    the service moves it into node_exporter's directory with a rename, which
    is what keeps node_exporter from ever reading a half-written file."""
    path = os.path.join(os.environ["STATE_DIRECTORY"], "slack.prom")
    with open(path, "w") as f:
        f.write(content)
    os.chmod(path, 0o644)


def main():
    with open(os.path.join(os.environ["CREDENTIALS_DIRECTORY"], "slack-token")) as f:
        token = f.read().strip()

    counts = dict.fromkeys(TYPES, 0)
    for member in members(token):
        counts[kind(member)] += 1

    # On any failure above the script has exited, and the previous file stays
    write_textfile(render(counts))
    print(" ".join(f"{t}={n}" for t, n in counts.items()))


if __name__ == "__main__":
    main()
