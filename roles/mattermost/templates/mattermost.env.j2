# {{ ansible_managed }}
# Read by mattermost.service and mattermost-import. These settings override
# config.json and are locked in the System Console.
MM_CONFIG="{{ mattermost_root_dir }}/config/config.json"
MM_SQLSETTINGS_DRIVERNAME="postgres"
# Peer authentication through the unix socket: no password
MM_SQLSETTINGS_DATASOURCE="postgres://mattermost@/mattermost?host=/run/postgresql&sslmode=disable&connect_timeout=10"
MM_SERVICESETTINGS_SITEURL="{{ mattermost_site_url }}"
MM_SERVICESETTINGS_LISTENADDRESS="127.0.0.1:8065"
# For mmctl --local, as user mattermost
MM_SERVICESETTINGS_ENABLELOCALMODE="true"
MM_FILESETTINGS_DIRECTORY="{{ mattermost_root_dir }}/data/"
# Logs only go to the journal
MM_LOGSETTINGS_ENABLEFILE="false"
{% if deployment_is_dev %}
# Never email or push-notify the real users from a development VM, which may
# hold a copy of the production data: nothing listens on port 25 there
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS="false"
MM_EMAILSETTINGS_SENDPUSHNOTIFICATIONS="false"
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION="false"
MM_EMAILSETTINGS_SMTPSERVER="127.0.0.1"
MM_EMAILSETTINGS_SMTPPORT="25"
{% endif %}
