{
  "store": {{ borg_backup_monitor_store | to_json }},
  "source": {{ inventory_hostname | to_json }},
  "backup_set": {{ borgmatic_snippet_name | to_json }},
  "repository": {{ (borg_backup_monitor_store ~ '/' ~ inventory_hostname ~ '/' ~ borgmatic_snippet_name) | to_json }},
  "repository_label": {{ (borg_backup_monitor_store ~ '-' ~ borgmatic_snippet_name) | to_json }},
  "config": {{ borgmatic_snippet_config | to_json }},
  "stale_after_seconds": {{ borg_backup_monitor_stale_after_seconds | int }}
}
