# Generated by Ansible from roles/blackbox_exporter/templates/blackbox.yml.j2
# Targets are declared in group_vars/webservers/vars.yml
#
# One module per application. Prometheus picks the module by passing its name
# in the ?module= parameter of the probe request.
modules:
{% for target in blackbox_exporter_targets %}
  {{ target.name }}:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [200]
      # The marker expected in the body: this is what separates "the server
      # answers" from "the application works".
      fail_if_body_not_matches_regexp:
        - {{ target.expect | to_json }}
{% if deployment_is_dev | bool %}
      # Caddy serves the .localhost aliases with its internal CA, which is not
      # in the system trust store. Same condition as the caddy role's
      # local_certs.
      tls_config:
        insecure_skip_verify: true
{% endif %}
{% endfor %}
