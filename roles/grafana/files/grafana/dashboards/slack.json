{
  "editable": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Active, non-guest, human members. The Slack for Nonprofits free Pro plan covers workspaces of 250 or fewer members.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 200
              },
              {
                "color": "red",
                "value": 250
              }
            ]
          },
          "decimals": 0,
          "unit": "none",
          "min": 0,
          "max": 250
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(slack_workspace_members{type=\"full\"})",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Slack Members",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 2,
      "title": "",
      "type": "stat",
      "gridPos": {
        "h": 2,
        "w": 5,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(node_textfile_mtime_seconds{file=~\".*/slack.prom\"}) * 1000 and on() ((time() - max(node_textfile_mtime_seconds{file=~\".*/slack.prom\"})) < 90000)",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(node_textfile_mtime_seconds{file=~\".*/slack.prom\"}) * 1000 and on() ((time() - max(node_textfile_mtime_seconds{file=~\".*/slack.prom\"})) >= 90000 < 176400)",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(node_textfile_mtime_seconds{file=~\".*/slack.prom\"}) * 1000 and on() ((time() - max(node_textfile_mtime_seconds{file=~\".*/slack.prom\"})) >= 176400)",
          "instant": true,
          "range": false,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "displayName": "Updated",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 12,
          "valueSize": 14
        }
      },
      "transparent": true,
      "description": "Orange once the count is more than 25 hours old (a missed daily run), red after 49 hours (two missed runs)."
    }
  ],
  "schemaVersion": 41,
  "tags": [
    "slack"
  ],
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "title": "Slack",
  "uid": "slack-members"
}
