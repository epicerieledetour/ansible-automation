{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last successful backup"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "No archive"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Age (days)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 2
                    },
                    {
                      "color": "red",
                      "value": 7
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "dark-green"
                      },
                      "1": {
                        "text": "STALE",
                        "color": "red"
                      },
                      "2": {
                        "text": "NO BACKUP",
                        "color": "orange"
                      },
                      "3": {
                        "text": "ERROR",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "md",
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Backup Set"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "editorMode": "code",
          "expr": "maintenance_borg_repository_last_archive_timestamp_seconds{job=\"node\"} * 1000",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "editorMode": "code",
          "expr": "((time() - maintenance_borg_repository_last_archive_timestamp_seconds{job=\"node\"}) / 86400) and on (repository) (maintenance_borg_repository_has_archive{job=\"node\"} == 1)",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "editorMode": "code",
          "expr": "3 * (1 - maintenance_borg_repository_probe_success{job=\"node\"}) + 2 * maintenance_borg_repository_probe_success{job=\"node\"} * (1 - maintenance_borg_repository_has_archive{job=\"node\"}) + maintenance_borg_repository_probe_success{job=\"node\"} * maintenance_borg_repository_has_archive{job=\"node\"} * ((time() - maintenance_borg_repository_last_archive_timestamp_seconds{job=\"node\"}) > bool maintenance_borg_repository_stale_after_seconds{job=\"node\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "repository",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "repository": true,
              "host": true,
              "host 1": true,
              "host 2": true,
              "host 3": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "store 1": true,
              "store 2": true,
              "source 1": true,
              "source 2": true,
              "backup_set 1": true,
              "backup_set 2": true
            },
            "indexByName": {
              "backup_set 3": 1,
              "source 3": 2,
              "store 3": 3,
              "Value #A": 4,
              "Value #B": 5,
              "Value #C": 6
            },
            "renameByName": {
              "backup_set 3": "Backup Set",
              "source 3": "Source",
              "store 3": "Store",
              "Value #A": "Last successful backup",
              "Value #B": "Age (days)",
              "Value #C": "Status"
            }
          }
        }
      ],
      "title": "Borg backup status by repository",
      "description": "Shows the latest archive in each Borg repository. A repository is stale when it exceeds its configured backup age threshold. ERROR means the repository could not be queried; the last known archive date is retained when available.",
      "type": "table"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "maintenance",
    "backup",
    "borg"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "includeAll": false,
        "label": "Datasource",
        "name": "ds_prometheus",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Borg Backup Status",
  "uid": "borg-backup-status",
  "version": 1
}
