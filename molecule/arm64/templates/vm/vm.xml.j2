{% set arch = item.arch | default('x86_64') %}
{% set arm = (arch == 'aarch64') %}
{% set dtype = item.domain_type | default('kvm') %}
<domain type='{{ dtype }}'>
  <name>{{ item.name }}</name>
  <uuid>{{ lookup('lines', 'uuidgen') }}</uuid>
  <memory unit='GiB'>{{ item.memory_size | default(default_memory_size) }}</memory>
  <currentMemory unit='GiB'>{{ item.memory_size | default(default_memory_size) }}</currentMemory>
  <vcpu placement='static'>{{ item.vcpu | default(default_vcpu) }}</vcpu>
  <os{{ " firmware='efi'" if arm else "" }}>
{% if arm %}
    <firmware>
      <feature enabled='no' name='secure-boot'/>
    </firmware>
{% endif %}
    <type arch='{{ arch }}' machine='{{ "virt" if arm else "pc" }}'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
{% if not arm %}
    <apic/>
    <vmport state='off'/>
{% endif %}
  </features>
{% if arm and dtype == 'kvm' %}
  <cpu mode='host-passthrough' check='none'/>
{% else %}
  <cpu mode='custom' match='exact' check='none'>
    <model fallback='allow'>{{ item.cpu_model | default('max' if arm else 'qemu64') }}</model>
  </cpu>
{% endif %}
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <controller type='scsi' model='virtio-scsi'/>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{{ libvirt_default_image_path }}/{{ item.name }}.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='{{ libvirt_default_image_path }}/{{ item.name }}-cloud-init.iso'/>
      <target dev='sda' bus='scsi'/>
      <readonly/>
    </disk>
    <interface type='{{ "network" if item.bridge_name is not defined else "bridge" }}'>
      <mac address='{{ mac }}{{ range(10, 99) | random }}'/>
{% if item.bridge_name is not defined %}
      <source network='{{ item.network_name if item.network_name is defined else molecule_network_name }}'/>
{% else %}
      <source bridge='{{ item.bridge_name }}'/>
{% endif %}
      <model type='virtio'/>
    </interface>
    <serial type='pty'>
      <target port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
    <memballoon model='virtio'/>
  </devices>
</domain>
