---
extends: default

ignore: |
  .venv/
  # Fully vault-encrypted files are not YAML
  vault.yml
  vault.yaml

rules:
  # Compatible with what ansible-lint expects of a custom yamllint config
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  # Room for SSH public keys, URLs and command lines
  line-length:
    max: 160
